# Copy this file to deploy/.env and replace every replace-me value.
# Never commit deploy/.env.

COMPOSE_PROJECT_NAME=actantbot

# Approved application artifacts. Do not deploy the placeholder tag.
WORKDESK_SERVER_IMAGE=ghcr.io/kotobuki09/actantbot-workdesk-server:replace-with-approved-release
KERNEL_IMAGE=ghcr.io/kotobuki09/actantbot-kernel:replace-with-approved-release

# Public URL used by the operator smoke checks.
WORKDESK_PUBLIC_URL=https://workdesk.example.com

# WorkDesk database.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=workdesk
POSTGRES_USER=workdesk
POSTGRES_PASSWORD=replace-me-with-a-random-password
WORKDESK_DATABASE_URL=postgresql://workdesk:replace-me-with-a-random-password@workdesk-db:5432/workdesk

# Kernel database.
KERNEL_POSTGRES_DB=actantos
KERNEL_POSTGRES_USER=actantos
KERNEL_POSTGRES_PASSWORD=replace-me-with-a-random-password
KERNEL_DATABASE_URL=postgresql://actantos:replace-me-with-a-random-password@kernel-db:5432/actantos

# WorkDesk server.
WORKDESK_PORT=3200
NODE_ENV=production
OIDC_ISSUER=https://identity.example.com/realms/workdesk
OIDC_CLIENT_ID=workdesk-portal
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://workdesk.example.com/auth/callback
SESSION_SECRET=replace-me-with-at-least-32-random-characters
KERNEL_URL=http://kernel:3100
RUNBOOKS_DIR=/app/runbooks
WORKDESK_MODEL_ADAPTER=noop

# Kernel enforcement.
KERNEL_PORT=3100
ACTANTOS_EVALUATOR_MODE=production
ACTANTOS_HMAC_SECRET=replace-me-with-a-long-random-secret
# ACTANTOS_TOKEN_PUBLIC_KEY_FILE=/run/secrets/actantos-token-public-key
